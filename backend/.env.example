# ---- Server ----
NODE_ENV=development
HOST=0.0.0.0
PORT=4010
LOG_LEVEL=info

# ---- Database ----
# Leave DATABASE_URL empty for local SQLite (data/masar.sqlite); use postgres://user:pass@host:5432/masar in production.
DATABASE_URL=
SQLITE_PATH=data/masar.sqlite

# ---- URLs ----
# Origin of the frontend (login link in e-mails only; the API has no CORS surface)
FRONTEND_ORIGIN=http://localhost:3000

# ---- Security ----
# >= 32 random chars; required in production (openssl rand -hex 32). Keys the hash of e-mail verification codes.
SIGNING_SECRET=
TOKEN_TTL_DAYS=30
# Whose X-Forwarded-For to believe (the real visitor address for the per-IP rate limits). The Next.js server is the only
# client of this API, so name IT: "loopback" (same machine), a private range such as "10.0.0.0/8", or its address.
# A list is safe; "true" believes everyone (only for an API reachable solely through the Next.js server). "false" = ignore it,
# so every visitor shares the Next.js server's limits. See backend/README.md "Real client addresses".
TRUST_PROXY=false

# ---- E-mail verification by 6-digit code (OTP) ----
EMAIL_OTP_TTL_MINUTES=15
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Employee invitation (code e-mailed when an admin adds an employee; the employee enters it on /set-password) ----
# Hours the invitation code stays valid. Only an organization admin can send a new one.
INVITE_TTL_HOURS=48

# ---- Files ----
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10

# ---- Mail (SMTP) ----
# Setting SMTP_HOST turns real delivery on automatically. Without it (development/tests only) nothing is sent: the code is
# printed to the server console and kept in memory. Production refuses to start without SMTP_HOST.
# Gmail example: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MASAR <no-reply@masar.local>"
# auto (default) | console | smtp | none
MAIL_TRANSPORT=auto

# ---- Test-only control plane for the e2e suite (never in production) ----
ENABLE_TEST_CONTROLS=false

# ---- Hardening knobs ----
SCRYPT_LOG_N=15
RATE_LIMIT_SCALE=1
