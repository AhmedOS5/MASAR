{
  "name": "masar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "migrate:rollback": "node --env-file-if-exists=.env scripts/db.mjs rollback",
    "seed": "node --env-file-if-exists=.env scripts/db.mjs seed",
    "db:reset": "node --env-file-if-exists=.env scripts/db.mjs reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node --env-file-if-exists=.env scripts/cli.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "knex": "^3.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
