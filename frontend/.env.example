# ---- Server-side (never exposed to the browser) ----
# Base URL of the backend API (backend/ — http://localhost:4010 in development). A trailing /api is accepted.
# It must be the same origin as the backend's APP_ORIGIN (e-mail verification links are only followed on this origin).
API_URL=

# How many reverse proxies (Vercel, nginx, a load balancer …) sit in front of this Next.js server. The visitor's address is the
# N-th entry from the RIGHT of X-Forwarded-For (what the trusted proxies appended); anything to its left was written by the
# visitor and is ignored. It is forwarded to the backend so the per-IP rate limits see the visitor, not this server.
#   0 (default)  reached directly, e.g. local development: the header cannot be trusted, nothing is forwarded
#   1            one proxy in front. This is the DEFAULT ON VERCEL (set automatically); set it for nginx / ALB yourself
# The backend must trust this server in return: backend TRUST_PROXY (see backend/README.md, "Real client addresses").
TRUSTED_PROXY_HOPS=

# ---- Public (optional) ----
# Shown on the waiting-approval page as a "contact support" mailto link
NEXT_PUBLIC_SUPPORT_EMAIL=

# Fallback if API_URL is not set (kept for backwards compatibility)
NEXT_PUBLIC_API_URL=
